{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SoloConexionesCifradas",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::NOMBRE-DEL-BUCKET",
        "arn:aws:s3:::NOMBRE-DEL-BUCKET/*"
      ],
      "Condition": { "Bool": { "aws:SecureTransport": "false" } }
    },
    {
      "Sid": "SoloObjetosCifradosConKMS",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::NOMBRE-DEL-BUCKET/*",
      "Condition": {
        "StringNotEquals": { "s3:x-amz-server-side-encryption": "aws:kms" }
      }
    }
  ]
}
