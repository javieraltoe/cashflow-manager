# ============================================================
# CashFlow Manager - PRODUCCIÓN (plantilla). En el servidor:
#   cp .env.production.example .env  &&  chmod 600 .env
# Nunca subir el .env a Git. Generar cada secreto con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# ============================================================

# Dominio público (registro DNS tipo A apuntando a la IP elástica del servidor)
DOMAIN=cobranzas.miempresa.com.ar
# Email para avisos de Let's Encrypt (vencimiento de certificados)
ACME_EMAIL=sistemas@miempresa.com.ar

APP_ENV=production
LOG_LEVEL=INFO
APP_TIMEZONE=America/Argentina/Buenos_Aires

# OBLIGATORIO cambiarla: la API no arranca con un valor que empiece con "cambiar".
# Rotarla invalida todas las sesiones abiertas (todos vuelven a ingresar).
SECRET_KEY=cambiar-por-un-secreto-largo-y-aleatorio
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

POSTGRES_DB=cashflow
POSTGRES_USER=cashflow
POSTGRES_PASSWORD=cambiar-por-otro-secreto-largo

# Para scripts/backup/backup.py en el servidor
COMPOSE_FILE=docker-compose.prod.yml
