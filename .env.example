# ============================================================
# CashFlow Manager - variables de entorno (PLANTILLA)
# Copiar a .env:   Copy-Item .env.example .env
# .env NUNCA se sube a Git. Este archivo no contiene secretos reales.
# ============================================================

# --- Aplicación ---
APP_ENV=development
LOG_LEVEL=INFO
APP_TIMEZONE=America/Argentina/Buenos_Aires

# --- Seguridad ---
# Generar una clave propia (PowerShell, con el venv activado):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# En producción la API se niega a arrancar si empieza con "cambiar".
SECRET_KEY=cambiar-esta-clave-en-env
# Orígenes permitidos (coma-separados). Sin "*" en producción.
CORS_ORIGINS=http://localhost:8501
# Duración de sesiones
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Bloqueo de login tras N intentos fallidos durante M minutos
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- PostgreSQL ---
POSTGRES_DB=cashflow
POSTGRES_USER=cashflow
POSTGRES_PASSWORD=cambiar_password_dev
# Conexión desde tu PC (API corriendo fuera de Docker, tests, DBeaver).
# Dentro de Docker, docker-compose.yml fuerza host "db" y puerto 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# Base usada por los tests (se crea sola; por defecto <POSTGRES_DB>_test)
# TEST_POSTGRES_DB=cashflow_test

# --- Puertos publicados en 127.0.0.1 ---
POSTGRES_HOST_PORT=5433
API_HOST_PORT=8000
DASHBOARD_HOST_PORT=8501

# --- Escritorio ---
CASHFLOW_API_URL=http://localhost:8000/api/v1
